{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideascope.example/contracts/graph-patch-0.1.schema.json",
  "title": "IdeaScope GraphPatch 0.1 (planning draft)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "patchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
    },
    "branchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "ADD_NODE"
              },
              "node": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                  },
                  "kind": {
                    "enum": [
                      "question",
                      "concept",
                      "approach",
                      "finding",
                      "debate",
                      "gap",
                      "direction"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "claimIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                    },
                    "maxItems": 200,
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "parentId": { "type": ["string", "null"], "maxLength": 128 },
                  "depth": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "maxItems": 30,
                    "minItems": 0
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "title",
                  "summary",
                  "claimIds",
                  "parentId",
                  "depth",
                  "aliases"
                ]
              }
            },
            "required": [
              "op",
              "node"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "UPDATE_NODE"
              },
              "nodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              },
              "changes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "question",
                      "concept",
                      "approach",
                      "finding",
                      "debate",
                      "gap",
                      "direction"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "claimIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                    },
                    "maxItems": 200,
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "maxItems": 30,
                    "minItems": 0
                  }
                },
                "required": [],
                "minProperties": 1
              }
            },
            "required": [
              "op",
              "nodeId",
              "changes"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "ADD_CLAIM"
              },
              "claim": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "epistemicStatus": {
                    "enum": [
                      "sourced",
                      "inference",
                      "hypothesis",
                      "user_note"
                    ]
                  },
                  "evidenceLinks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "evidenceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                        },
                        "stance": {
                          "enum": [
                            "supports",
                            "opposes",
                            "background"
                          ]
                        }
                      },
                      "required": [
                        "evidenceId",
                        "stance"
                      ]
                    },
                    "maxItems": 60,
                    "minItems": 0
                  },
                  "qualifiers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "maxItems": 30,
                    "minItems": 0
                  },
                  "verification": {
                    "enum": [
                      "unreviewed",
                      "machine_checked",
                      "human_reviewed"
                    ]
                  }
                },
                "required": [
                  "id",
                  "text",
                  "epistemicStatus",
                  "evidenceLinks",
                  "qualifiers",
                  "verification"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "epistemicStatus": {
                          "const": "sourced"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "evidenceLinks": {
                          "type": "array",
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "op",
              "claim"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "UPDATE_CLAIM"
              },
              "claimId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              },
              "changes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "epistemicStatus": {
                    "enum": [
                      "sourced",
                      "inference",
                      "hypothesis",
                      "user_note"
                    ]
                  },
                  "evidenceLinks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "evidenceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                        },
                        "stance": {
                          "enum": [
                            "supports",
                            "opposes",
                            "background"
                          ]
                        }
                      },
                      "required": [
                        "evidenceId",
                        "stance"
                      ]
                    },
                    "maxItems": 60,
                    "minItems": 0
                  },
                  "qualifiers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "maxItems": 30,
                    "minItems": 0
                  },
                  "verification": {
                    "enum": [
                      "unreviewed",
                      "machine_checked",
                      "human_reviewed"
                    ]
                  }
                },
                "required": [],
                "minProperties": 1
              }
            },
            "required": [
              "op",
              "claimId",
              "changes"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "ADD_EDGE"
              },
              "edge": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                  },
                  "relation": {
                    "enum": [
                      "decomposes_into",
                      "addressed_by",
                      "requires",
                      "contrasts_with",
                      "limited_by",
                      "motivates",
                      "related_to"
                    ]
                  },
                  "role": { "enum": ["primary", "cross"] },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "claimIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                    },
                    "maxItems": 200,
                    "minItems": 0,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "source",
                  "target",
                  "relation",
                  "role",
                  "label",
                  "claimIds"
                ]
              }
            },
            "required": [
              "op",
              "edge"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "UPDATE_EDGE"
              },
              "edgeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              },
              "changes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                  },
                  "relation": {
                    "enum": [
                      "decomposes_into",
                      "addressed_by",
                      "requires",
                      "contrasts_with",
                      "limited_by",
                      "motivates",
                      "related_to"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "claimIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                    },
                    "maxItems": 200,
                    "minItems": 0,
                    "uniqueItems": true
                  }
                },
                "required": [],
                "minProperties": 1
              }
            },
            "required": [
              "op",
              "edgeId",
              "changes"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "ARCHIVE_NODE"
              },
              "nodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "op",
              "nodeId",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "MERGE_NODES"
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                },
                "maxItems": 20,
                "minItems": 1,
                "uniqueItems": true
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "op",
              "sourceIds",
              "targetId",
              "reason"
            ]
          }
        ]
      },
      "maxItems": 40,
      "minItems": 1
    }
  },
  "required": [
    "protocolVersion",
    "patchId",
    "runId",
    "workspaceId",
    "branchId",
    "baseRevision",
    "summary",
    "operations"
  ]
}
