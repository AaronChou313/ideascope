{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideascope.local/contracts/research-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "profileVersion", "id", "name", "mode", "description", "scope", "sourcePreferences", "venueGroups", "queryVocabulary", "arxivCategories", "languagePreferences", "provenance", "updatedAt"],
  "properties": {
    "documentType": { "const": "ideascope.research-profile" }, "profileVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/id" },
    "mode": { "enum": ["base", "session"] }, "description": { "type": "string", "maxLength": 2000 },
    "scope": { "type": "object", "additionalProperties": false, "required": ["domains", "subfields", "concepts"], "properties": {
      "domains": { "$ref": "#/$defs/stringList" }, "subfields": { "$ref": "#/$defs/stringList" }, "concepts": { "$ref": "#/$defs/stringList" }
    } },
    "sourcePreferences": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["sourceId", "priority"], "properties": {
      "sourceId": { "$ref": "#/$defs/id" }, "priority": { "$ref": "#/$defs/priority" },
      "purposes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 80 } }
    } } },
    "venueGroups": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "venues"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/id" },
      "venues": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["name", "aliases"], "properties": {
        "name": { "type": "string", "maxLength": 200 }, "aliases": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 100 } }, "priority": { "$ref": "#/$defs/priority" }
      } } }
    } } },
    "queryVocabulary": { "type": "array", "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "required": ["term", "aliases"], "properties": {
      "term": { "type": "string", "maxLength": 160 }, "aliases": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 160 } }
    } } },
    "arxivCategories": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "maxLength": 20 } },
    "languagePreferences": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "maxLength": 20 } },
    "provenance": { "enum": ["builtin", "manual", "imported", "ai_suggested", "session_derived"] },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "priority": { "type": "number", "minimum": 0, "maximum": 100 },
    "stringList": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "maxLength": 160 } }
  }
}
