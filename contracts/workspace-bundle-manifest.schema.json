{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ideascope.local/contracts/workspace-bundle-manifest-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["documentType", "bundleVersion", "createdWith", "exportedAt", "workspaces"],
  "properties": {
    "documentType": { "const": "ideascope.bundle" }, "bundleVersion": { "const": 1 },
    "createdWith": { "type": "string", "minLength": 1, "maxLength": 80 }, "exportedAt": { "type": "string", "format": "date-time" },
    "workspaces": { "type": "array", "minItems": 1, "maxItems": 250, "items": { "type": "object", "additionalProperties": false, "required": ["workspaceId", "title", "path", "sha256"], "properties": {
      "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 }, "title": { "type": "string", "minLength": 1, "maxLength": 300 },
      "path": { "type": "string", "pattern": "^workspaces/[A-Za-z0-9._-]+\\.ideascope\\.json$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    } } },
    "resources": { "type": "object", "additionalProperties": false, "properties": {
      "sources": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^resources/sources/" } },
      "profiles": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^resources/profiles/" } }
    } }
  }
}
